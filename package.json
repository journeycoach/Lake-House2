{
  "name": "lakehouse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:migrate": "drizzle-kit migrate",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "db:push": "dotenv -e .env.development.local -- drizzle-kit push",
    "seed": "dotenv -e .env.development.local -- tsx scripts/seed.ts",
    "ship": "vercel deploy --prod",
    "restore": "dotenv -e .env.development.local -- tsx scripts/restore.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.8",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
